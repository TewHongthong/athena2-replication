      "suffix": null,
      "minLength": null,
      "maxLength": null,
      "forbiddenPatterns": [
        "^(?!(?:bln|bl)_[A-Za-z0-9])"
      ],
      "hidePatterns": true,
      "allowedPrefixes": [
        "bln",
        "bl"
      ],
      "description": "The name of a Boolean variable starts with the Boolean type prefix (bln; the type table also lists bl), then a verb and an object or an adjective: [return_type]_[verb]_[noun]_[adjective].",
      "rationale": "A Boolean reads like a question or state: bln_Is_File_Opened.",
      "severity": "MUST",
      "sourceStandardId": "GSCS",
      "sourceSection": "Naming Boolean variables",
      "identifierKind": "boolean_variable"
    },
