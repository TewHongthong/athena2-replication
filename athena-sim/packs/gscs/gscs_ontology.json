    {
      "id": "GSCS-VAR-TYPED-PREFIX",
      "type": "NamingRule",
      "identifierKinds": [
        "variable",
        "parameter",
        "field"
      ],
      "casing": null,
      "prefix": null,
      "suffix": null,
      "minLength": null,
      "maxLength": null,
      "forbiddenPatterns": [
        "^(?!(?:bln|bl|ch|uc|us|ul|by|str|dt|s|l|f|d|b|i)_[A-Za-z0-9])"
      ],
      "hidePatterns": true,
      "allowedPrefixes": [
        "bln",
        "bl",
        "ch",
        "uc",
        "us",
        "ul",
        "by",
        "str",
        "dt",
        "s",
        "l",
        "f",
        "d",
        "b",
        "i"
      ],
      "description": "Names of variables should be a noun with or without a modifier and use a prefix to identify the data type of the variable: [type prefix]_[noun], [type prefix]_[adjective] or [type prefix]_[adjective]_[noun]. The prefix is followed by an underscore and the words are separated by underscores. Clear, complete and meaningful names make the code more readable.",
      "rationale": "The prefix shows the data type at every use of the variable.",
      "severity": "MUST",
      "sourceStandardId": "GSCS",
      "sourceSection": "Naming Variables; Identifying variable types",
      "identifierKind": "variable"
    },
    {
