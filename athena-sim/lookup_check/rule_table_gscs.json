{
 "standards": {
  "GSCS": "General Style and Coding Standards for Software Projects (preliminary version, 2015)"
 },
 "rules": [
  {
   "id": "GSCS-VAR-TYPED-PREFIX",
   "type": "NamingRule",
   "identifierKinds": [
    "variable",
    "parameter",
    "field"
   ],
   "casing": null,
   "prefix": null,
   "suffix": null,
   "minLength": null,
   "maxLength": null,
   "forbiddenPatterns": [
    "^(?!(?:bln|bl|ch|uc|us|ul|by|str|dt|s|l|f|d|b|i)_[A-Za-z0-9])"
   ],
   "hidePatterns": true,
   "allowedPrefixes": [
    "bln",
    "bl",
    "ch",
    "uc",
    "us",
    "ul",
    "by",
    "str",
    "dt",
    "s",
    "l",
    "f",
    "d",
    "b",
    "i"
   ],
   "description": "Names of variables should be a noun with or without a modifier and use a prefix to identify the data type of the variable: [type prefix]_[noun], [type prefix]_[adjective] or [type prefix]_[adjective]_[noun]. The prefix is followed by an underscore and the words are separated by underscores. Clear, complete and meaningful names make the code more readable.",
   "rationale": "The prefix shows the data type at every use of the variable.",
   "severity": "MUST",
   "sourceStandardId": "GSCS",
   "sourceSection": "Naming Variables; Identifying variable types",
   "identifierKind": "variable",
   "_standard": "GSCS",
   "_languages": [
    "java",
    "python",
    "cpp",
    "csharp",
    "javascript",
    "typescript"
   ],
   "_kinds": [
    "variable",
    "parameter",
    "field"
   ],
   "_examples": [
    {
     "id": "EX-GSCS-VAR-TYPED-PREFIX-1",
     "type": "Example",
     "ruleId": "GSCS-VAR-TYPED-PREFIX",
     "code": "dt_current_time",
     "isCompliant": true,
     "explanation": "date-time prefix, adjective 'current', noun 'time' (from the document)"
    },
    {
     "id": "EX-GSCS-VAR-TYPED-PREFIX-2",
     "type": "Example",
     "ruleId": "GSCS-VAR-TYPED-PREFIX",
     "code": "currentTime",
     "isCompliant": false,
     "explanation": "no type prefix (authored example)"
    },
    {
     "id": "EX-GSCS-VAR-TYPED-PREFIX-3",
     "type": "Example",
     "ruleId": "GSCS-VAR-TYPED-PREFIX",
     "code": "i_student_total_num",
     "isCompliant": true,
     "explanation": "integer prefix (from the document)"
    },
    {
     "id": "EX-GSCS-VAR-TYPED-PREFIX-4",
     "type": "Example",
     "ruleId": "GSCS-VAR-TYPED-PREFIX",
     "code": "studentTotalNum",
     "isCompliant": false,
     "explanation": "no type prefix, camelCase instead of underscores (authored example)"
    },
    {
     "id": "EX-GSCS-VAR-TYPED-PREFIX-5",
     "type": "Example",
     "ruleId": "GSCS-VAR-TYPED-PREFIX",
     "code": "f_gpax",
     "isCompliant": true,
     "explanation": "float prefix (from the document)"
    }
   ]
  },
