  {
   "id": "GSCS-PROC-VERB-OBJECT",
   "type": "NamingRule",
   "identifierKinds": [
    "procedure"
   ],
   "casing": null,
   "prefix": null,
   "suffix": null,
   "minLength": null,
   "maxLength": null,
   "forbiddenPatterns": [
    "^(?![A-Z][a-z0-9]*_[A-Za-z0-9])"
   ],
   "hidePatterns": true,
   "description": "A function without a return value (procedure) is named with a verb and, whenever appropriate, an object: [verb]_[object]. The verb starts with a capital letter and words are separated by underscores (Enter_Height_and_Weight, Calculate_GPAX). No type prefix.",
   "rationale": "Verb-object names say what the procedure does.",
   "severity": "MUST",
   "sourceStandardId": "GSCS",
   "sourceSection": "Naming Convention for Functions - function without return type",
   "identifierKind": "procedure",
   "_standard": "GSCS",
   "_languages": [
    "java",
    "python",
    "cpp",
    "csharp",
    "javascript",
    "typescript"
   ],
   "_kinds": [
    "procedure"
   ],
   "_examples": [
    {
     "id": "EX-GSCS-PROC-VERB-OBJECT-1",
     "type": "Example",
     "ruleId": "GSCS-PROC-VERB-OBJECT",
     "code": "Calculate_GPAX",
     "isCompliant": true,
     "explanation": "verb + object (from the document)"
    },
    {
     "id": "EX-GSCS-PROC-VERB-OBJECT-2",
     "type": "Example",
     "ruleId": "GSCS-PROC-VERB-OBJECT",
     "code": "calculateGPAX",
     "isCompliant": false,
     "explanation": "camelCase, no underscore between verb and object (authored example)"
    },
    {
     "id": "EX-GSCS-PROC-VERB-OBJECT-3",
     "type": "Example",
     "ruleId": "GSCS-PROC-VERB-OBJECT",
     "code": "Enter_Height_and_Weight",
     "isCompliant": true,
     "explanation": "verb + object (from the document)"
    },
    {
     "id": "EX-GSCS-PROC-VERB-OBJECT-4",
     "type": "Example",
     "ruleId": "GSCS-PROC-VERB-OBJECT",
     "code": "calculate_gpax",
     "isCompliant": false,
     "explanation": "verb not capitalised (authored example)"
    }
   ]
  },
  {
   "id": "GSCS-FUNC-RETURN-PREFIX",
   "type": "NamingRule",
   "identifierKinds": [
    "function"
   ],
   "casing": null,
   "prefix": null,
   "suffix": null,
   "minLength": null,
   "maxLength": null,
   "forbiddenPatterns": [
    "^(?!(?:bln|bl|ch|uc|us|ul|by|str|dt|s|l|f|d|b|i)_[A-Z][A-Za-z0-9]*_[A-Za-z0-9])"
   ],
   "hidePatterns": true,
   "allowedPrefixes": [
