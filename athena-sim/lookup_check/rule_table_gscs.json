    "d",
    "b",
    "i"
   ],
   "description": "A function that returns a value uses a prefix identifying the return type, then a verb and a noun: [return_type]_[verb]_[noun]. The verb starts with a capital letter and words are separated by underscores (i_Get_Time, bln_Create_OutputFile).",
   "rationale": "The prefix shows the return type at every call.",
   "severity": "MUST",
   "sourceStandardId": "GSCS",
   "sourceSection": "Naming Convention for Functions - function with return type",
   "identifierKind": "function",
   "_standard": "GSCS",
   "_languages": [
