  {
   "id": "GSCS-DOC-FUNC-HEADER",
   "type": "CommentRule",
   "identifierKinds": [
    "function",
    "procedure"
   ],
   "format": "block-comment",
   "requiredLabels": [
    "Function Objective",
    "Input parameters",
    "Function description",
    "Return Value",
    "Created By",
    "Create Date",
    "Revised By",
    "Revised Date"
   ],
   "optionalFilledLabels": [
    "Revised By",
    "Revised Date"
   ],
   "triggerCondition": "every function or procedure",
   "description": "Put a comment before starting a function or procedure to describe the objective of the function, its input parameters and its returned value, using this template:\n/* Function Objective:\nInput parameters :\nFunction description:\nReturn Value : [void, int, float, string] GPA value\nCreated By : Programmer A\nCreate Date:\nRevised By:\nRevised Date:\n*/",
   "severity": "MUST",
   "sourceStandardId": "GSCS",
   "sourceSection": "Function/Procedure",
   "identifierKind": "function",
   "_standard": "GSCS",
   "_languages": [
    "java",
    "python",
    "cpp",
    "csharp",
    "javascript",
    "typescript"
   ],
   "_kinds": [
    "function",
    "procedure"
   ],
   "_examples": [
    {
     "id": "EX-GSCS-DOC-FUNC-HEADER-1",
     "type": "Example",
     "ruleId": "GSCS-DOC-FUNC-HEADER",
     "code": "/* Function Objective: ...\nInput parameters : ...\nFunction description: ...\nReturn Value : float GPA value\nCreated By : Programmer A\nCreate Date:\nRevised By:\nRevised Date:\n*/\nfloat f_Calculate_Gpax(float f_point_total, float f_credit_total) {",
     "isCompliant": true,
     "explanation": "header template placed directly above the function (from the document)"
    },
    {
     "id": "EX-GSCS-DOC-FUNC-HEADER-2",
     "type": "Example",
     "ruleId": "GSCS-DOC-FUNC-HEADER",
     "code": "// calculates gpax\nfloat f_Calculate_Gpax(float f_point_total, float f_credit_total) {",
     "isCompliant": false,
     "explanation": "one-line comment; the header template labels are missing (authored example)"
    }
   ]
